# Copiar a .env y completar. El server NO arranca sin SECRET_KEY.

# Postgres (contenedor dev: dafstudio-pg, postgres:16 — ver docker-compose.yml)
DB_NAME=daf_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=admin

# Pool asyncpg (opcionales; defaults 2/10)
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=10

# Firma de JWTs. Generar una propia: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# DEBUG=1 agrega el traceback a las respuestas de error (solo dev).
DEBUG=1

# Google Sign-In: client ids OAuth separados por coma (web, android, ios).
# Sin esto, /api/auth/google/ devuelve 503. Ver docs/AUTH_SETUP.md.
# GOOGLE_OAUTH_CLIENT_IDS=
